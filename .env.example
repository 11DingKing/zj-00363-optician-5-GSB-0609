# =====================================================================
# 生产环境 (.env) 模板
# 复制为 .env 后按需修改：cp .env.example .env
# =====================================================================

# 激活的 Spring Profile，prod 环境固定为 prod
SPRING_PROFILES_ACTIVE=prod

# 数据源 JDBC URL（默认使用容器内持久化的 H2 文件库；生产可替换为 MySQL/PostgreSQL）
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/school-entry-audit;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# 数据源驱动类名
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver

# 数据库用户名
SPRING_DATASOURCE_USERNAME=sa

# 数据库密码（生产环境务必设置强口令）
SPRING_DATASOURCE_PASSWORD=

# Hibernate 方言
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect

# 服务对外监听端口
SERVER_PORT=8080

# JVM 额外参数（可选，例如 -Xms256m -Xmx512m）
JAVA_OPTS=-Xms256m -Xmx512m
